{
  "version": 2,
  "builds": [
    {
      "src": "2port/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "2port/dist/routing/browser"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
