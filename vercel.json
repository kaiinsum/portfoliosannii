{
  "version": 2,
  "buildCommand": "cd 2port && npm install && npm run vercel-build",
  "outputDirectory": "2port/dist/routing/browser",
  "installCommand": "cd 2port && npm install",
  "builds": [
    {
      "src": "2port/package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "2port/dist/routing/browser"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/2port/dist/routing/browser/index.html" }
  ]
}
